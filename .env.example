# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- database (Neon)
DATABASE_URL="postgresql://user:password@host/kmcp?sslmode=require"
DIRECT_URL="postgresql://user:password@host/kmcp?sslmode=require"

# ---------------------------------------------------------------- auth
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------- object storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=kmcp-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_SIGNED_URL_TTL=900

# ---------------------------------------------------------------- payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# ---------------------------------------------------------------- messaging
# Every value here is optional. With a channel's credentials unset its adapter
# is a no-op that records the intent as a FAILED delivery carrying the reason —
# so local development, CI and the demo build need no live provider accounts,
# and nothing is ever silently dropped.

# SMS, via MSG91.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# The DLT-registered flow id. Indian networks register message content with the
# regulator, so a transactional SMS names a registered template.
MSG91_TEMPLATE_ID=

# WhatsApp, via Meta's Cloud API. Note that free-form text only reaches a person
# who has messaged the business in the last 24 hours; outside that window Meta
# refuses it, and the refusal is recorded against the delivery row.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Email, via Resend. The from-address must be on a domain verified with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="KMCP <no-reply@example.gov.in>"

# Where a link inside a message points — the citizen app, not this API. Unset,
# messages simply carry no link rather than one to the wrong host.
PUBLIC_APP_URL=

# ---------------------------------------------------------------- activity monitor
# Optional. Without it, IP geolocation still works via Vercel's edge headers and
# ip-api.com. With it you additionally get PIN codes, ASN and VPN/proxy detection.
IPINFO_TOKEN=

# ---------------------------------------------------------------- live cameras
# HLS storage for the push→R2 camera pipeline. The Edge Agent PUTs HLS to
# /api/edge/ingest/<key>/<file>; the bytes are kept here and played back to
# admins. MEDIA_BACKEND=r2 reuses the S3_* credentials above (R2); "fs" is for
# local development only. HLS objects live under HLS_KEY_PREFIX in the bucket.
MEDIA_BACKEND=r2
HLS_KEY_PREFIX=hls
# Optional. A public/CDN base for segment reads. Leave UNSET to keep every
# playback behind the admin gate — a public URL would bypass it.
HLS_PUBLIC_BASE=
# Hard timeout (ms) on storage calls, so a misconfigured bucket fails fast.
R2_TIMEOUT_MS=4000
# Local directory for MEDIA_BACKEND=fs (development only; ignored on Vercel).
MEDIA_FS_DIR=

# ---------------------------------------------------------------- ops
LOG_LEVEL=info

# Shared secret the scheduler presents to the sweep endpoint, as
# `Authorization: Bearer <secret>` or `x-cron-secret`. Vercel Cron sends the
# bearer form automatically once this is set as a project environment variable.
# Leaving it empty does not open the endpoint up — it closes it entirely.
CRON_SECRET=

SWAGGER_ENABLED=true

# ---------------------------------------------------------------- error reporting
# Leave it empty and the SDK is never started — nothing is collected and nothing
# leaves the process. Set it and every 5xx arrives tagged with the request id from
# `meta.requestId`, so an alert and the audit rows for the same request line up.
# Citizen data (plates, phone numbers, coordinates) is stripped before sending;
# see src/observability/scrub.ts for the field list.
SENTRY_DSN=
# Optional label. Defaults to VERCEL_ENV, then NODE_ENV.
SENTRY_ENVIRONMENT=
