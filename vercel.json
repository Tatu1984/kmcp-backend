{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "dist/**"
    }
  },
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/overstay-sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/v1/cron/retention-purge",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/v1/cron/report-schedules",
      "schedule": "*/15 * * * *"
    }
  ]
}
