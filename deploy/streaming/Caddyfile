# TLS in front of MediaMTX.
#
# The portal is served over HTTPS, so these must be too: a browser blocks
# http:// media on an https:// page as mixed content, and does it silently —
# the camera tile sits on "connecting" forever with nothing to say why.
#
# Caddy obtains and renews the certificates itself. Both names must resolve to
# this box before it starts, or the ACME challenge fails.

{
	email {$ACME_EMAIL}
}

# HLS: the default transport, a few seconds behind, plays everywhere.
video.{$DOMAIN} {
	reverse_proxy mediamtx:8888

	# The portal is a different origin, and asks for the playlist with fetch.
	header {
		Access-Control-Allow-Origin "*"
		-Server
	}
}

# WebRTC signalling (WHEP). The media itself travels over UDP 8189 direct to
# the container and does not pass through here.
webrtc.{$DOMAIN} {
	reverse_proxy mediamtx:8889

	header {
		Access-Control-Allow-Origin "*"
		-Server
	}
}

# The control API, which the KMCP API calls to point the gateway at a camera.
#
# This would be better off private, and the first draft of this deployment kept
# it that way — anyone who reaches it can configure this server to pull any
# camera they like. It is published because the API runs on Vercel, where a
# serverless function has no fixed egress address to allow through a firewall,
# so there is no private path to keep it on.
#
# What defends it instead: TLS, a password the API sends on every request, and
# a hostname that appears in no page. If the API ever moves to a box on this
# network — the AWS plan — delete this block, publish 9997 to localhost in
# docker-compose.yml, and drop the two credentials from the environment.
control.{$DOMAIN} {
	basic_auth {
		{$CONTROL_USER} {$CONTROL_PASSWORD_HASH}
	}
	reverse_proxy mediamtx:9997

	header -Server
}
