# The hostname this gateway answers on. Two names are served from it:
#   video.<DOMAIN>   — HLS
#   webrtc.<DOMAIN>  — WebRTC signalling
# Both must resolve to this box before `docker compose up`, or the certificate
# cannot be issued.
DOMAIN=infinititechpartners.com
ACME_EMAIL=ops@infinititechpartners.com

# Two passwords, neither of which is a person's. Generate with
#   openssl rand -base64 24
#
# READ is presented when a viewer's request is proxied through to a stream.
# PUBLISH is for an on-site agent pushing cameras up (the NAT topology).
GATEWAY_READ_PASSWORD=
GATEWAY_PUBLISH_PASSWORD=

# The control API's credentials.
#
# CONTROL_USER and the plaintext password go into the *API's* environment as
# MEDIAMTX_CONTROL_USER and MEDIAMTX_CONTROL_PASSWORD. Caddy stores only a
# hash, which is why there are two forms of the same secret here:
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
CONTROL_USER=kmcp-api
CONTROL_PASSWORD_HASH=
